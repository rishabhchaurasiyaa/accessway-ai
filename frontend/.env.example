# ACCESSWAY AI — Frontend Environment Variables Template
# Copy this file to .env or .env.local for local development.
# IMPORTANT: Never place private backend secrets, database passwords, or service-role keys here.

# Canonical Backend API Base URL (Root URL of the FastAPI backend)
# In local development, defaults to http://127.0.0.1:8000.
# The API client automatically appends the /api/v1 prefix.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Application Metadata
VITE_APP_TITLE=ACCESSWAY AI
VITE_APP_VERSION=1.0.0
