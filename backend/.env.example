# ============================================================================
# ACCESSWAY AI — Backend Environment Configuration Template
# Target Campus: Lovely Professional University (LPU)
# ============================================================================
# INSTRUCTIONS FOR PROJECT OWNER:
# 1. Copy this template to `backend/.env`.
# 2. Populate with your authentic Supabase project credentials.
# 3. SECURITY NOTICE: NEVER commit `backend/.env` or secrets to version control.
#    Never share your service-role key or database password publicly.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. Runtime Environment & Server Configuration
# ----------------------------------------------------------------------------
# Values: 'development', 'test', 'production'
# When set to 'production', the application strictly enforces authentic PostgreSQL
# credentials and rejects default/placeholder secrets.
APP_ENV=development
APP_ENVIRONMENT=development
APP_NAME="ACCESSWAY AI — Accessible Campus Navigator API"
DEBUG=False
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------------------------
# 2. CORS Configuration
# ----------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (no trailing slashes)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ----------------------------------------------------------------------------
# 3. Supabase PostgreSQL Database Connection
# ----------------------------------------------------------------------------
# Obtain from Supabase Dashboard -> Project Settings -> Database -> Connection string
# SQLAlchemy Async requires `postgresql+asyncpg://` protocol. (The app will automatically
# normalize `postgresql://` to `postgresql+asyncpg://`).
#
# Option A: Direct Connection (IPv6 / Dedicated IP):
#   postgresql+asyncpg://postgres:[YOUR-DB-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
#
# Option B: Session Pooler (IPv4 compatible, Port 5432 - Recommended for standard backends):
#   postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
#
# Local development default:
DATABASE_URL=postgresql+asyncpg://postgres:your_password_here@localhost:5432/postgres

# ----------------------------------------------------------------------------
# 4. Supabase Auth & Admin API Credentials (CONFIDENTIAL: Strictly Backend Only)
# ----------------------------------------------------------------------------
# Obtain from Supabase Dashboard -> Project Settings -> API
# - SUPABASE_URL: Project URL (e.g. https://[YOUR-PROJECT-REF].supabase.co)
# - SUPABASE_SERVICE_ROLE_KEY: The `service_role` secret (bypasses RLS for trusted admin actions)
#
# WARNING: Keep SUPABASE_SERVICE_ROLE_KEY confidential. NEVER bundle it in frontend code.
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# ----------------------------------------------------------------------------
# 5. Cryptographic Security & JWT Signing
# ----------------------------------------------------------------------------
# Used for cryptographically signing backend session tokens and admin authorization.
# Generate in production via: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_secure_random_64_character_hex_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# ----------------------------------------------------------------------------
# 6. Safety & Demonstration Mode
# ----------------------------------------------------------------------------
# Converted to production mode (False). Synthetic data is isolated to unit tests.
IS_SYNTHETIC_DATA_MODE=False
